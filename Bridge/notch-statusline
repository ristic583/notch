#!/bin/sh
# Claude Code status line command. Claude Code pipes a JSON blob in on every
# update; it carries the official subscription usage (rate_limits), which is
# not available anywhere else locally. We store it for Notch and print a short
# line so the status line still shows something useful.
DIR="$HOME/Library/Application Support/Notch"
mkdir -p "$DIR" 2>/dev/null
INPUT=$(cat)
printf '%s' "$INPUT" > "$DIR/usage.json.tmp" && mv "$DIR/usage.json.tmp" "$DIR/usage.json"

if [ -x /usr/bin/jq ]; then
    printf '%s' "$INPUT" | /usr/bin/jq -r '
        [ (.model.display_name // empty),
          (if .rate_limits.five_hour then "5h \(.rate_limits.five_hour.used_percentage | floor)%" else empty end),
          (if .rate_limits.seven_day then "7d \(.rate_limits.seven_day.used_percentage | floor)%" else empty end),
          (if .context_window.used_percentage then "ctx \(.context_window.used_percentage | floor)%" else empty end)
        ] | join("  ·  ")'
fi
exit 0
